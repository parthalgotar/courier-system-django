DJANGO_SECRET_KEY=change-this-secret-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Celery / Redis (asynchronous invoice e-mail + order notifications) ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
# Set True to run e-mail tasks inline WITHOUT Redis/worker (local dev only).
CELERY_TASK_ALWAYS_EAGER=False

# ---- E-mail Delivery Configuration ----
# Default prints e-mails to the console (development only; no emails are sent).
# For real delivery, configure an SMTP provider:
#
# Option A: Gmail SMTP (easiest for testing - requires a 16-character Google "App Password"):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=yourname@gmail.com
# EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
# DEFAULT_FROM_EMAIL=yourname@gmail.com
#
# Option B: SendGrid SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=SG.your-sendgrid-api-key
# DEFAULT_FROM_EMAIL=verified-sender@yourdomain.com
#
# Option C: Custom / Other SMTP:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_HOST_USER=postmaster@yourdomain.com
# EMAIL_HOST_PASSWORD=your_smtp_password
# DEFAULT_FROM_EMAIL=billing@yourdomain.com

# ---- SMS notifications ----
# Set to "twilio" to send real SMS. Requires: pip install twilio
# Default is "log" — messages are only written to the application log.
SMS_BACKEND=log
# SMS_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# SMS_AUTH_TOKEN=your_auth_token
# SMS_FROM_NUMBER=+1234567890

# ---- Dispatcher / Operations notification email ----
# Delivery-failed alerts are sent to this address.
DISPATCHER_NOTIFICATION_EMAIL=dispatcher@yourcompany.com
